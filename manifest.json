{
  "manifest_version": 3,
  "name": "Boton de Descarga Personalizado",
  "version": "1.0",
  "description": "Agrega un boton de descarga a cada modulo desplegable de la pagina.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "file://*/*",
        "https://miel.unlam.edu.ar/contenido/archivos/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}