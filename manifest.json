{
  "manifest_version": 3,
  "name": "Miel++",
  "version": "1.0",
  "description": "Agrega un boton de descarga a cada modulo desplegable de la pagina de contenidos de una materia",
  "permissions": [],  
  "content_scripts": [
    {
      "matches": [
        "file://*/*",
        "https://miel.unlam.edu.ar/contenido/archivos/*"
      ],
      "js": [
        "libs/zip.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}