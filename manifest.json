{
  "manifest_version": 3,
  "name": "Miel++",
  "version": "1.2",
  "description": "Agrega un boton de descarga a cada modulo desplegable de la pagina de contenidos de una materia",
  "permissions": ["activeTab"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://miel.unlam.edu.ar/contenido/archivos/*",
        "https://mielhistorico.unlam.edu.ar/*/contenido/archivos/*"
      ],
      "js": [
        "libs/zip.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "64": "assets/mielpp.png"
  },
  "browser_specific_settings": {
  "gecko": {
    "id": "{97cdefd6-3280-4234-87fc-c17934921864}",
    "data_collection_permissions": {
      "required": [
        "none"
      ]
    },
    "strict_min_version": "115.0"
  }
}
}